{
  "title": "LATIN — Pour la vie",
  "duration": 105,
  "chapters": [
    {
      "start": 2.8,
      "end": 7.8,
      "latin": "Ave !",
      "translation": "Salut ! / Je te salue !",
      "author": "Salutation Romaine"
    },
    {
      "start": 7.8,
      "end": 14.8,
      "latin": "Tu quoque, mi fili !",
      "translation": "Toi aussi, mon fils !",
      "author": "Jules César, 44 av. J.-C."
    },
    {
      "start": 14.8,
      "end": 20.8,
      "latin": "Alea jacta est.",
      "translation": "Le sort en est jeté.",
      "author": "Jules César, 49 av. J.-C."
    },
    {
      "start": 20.8,
      "end": 27.0,
      "latin": "Veni, vidi, vici.",
      "translation": "Je suis venu, j'ai vu, j'ai vaincu.",
      "author": "Jules César, 47 av. J.-C."
    },
    {
      "start": 27.0,
      "end": 34.0,
      "latin": "Dura lex, sed lex.",
      "translation": "La loi est dure, mais c'est la loi.",
      "author": "Maxime Juridique"
    },
    {
      "start": 34.0,
      "end": 42.0,
      "latin": "Si vis pacem, para bellum.",
      "translation": "Si tu veux la paix, prépare la guerre.",
      "author": "Végèce, IVe siècle"
    },
    {
      "start": 42.0,
      "end": 49.4,
      "latin": "Mens sana in corpore sano.",
      "translation": "Un esprit sain dans un corps sain.",
      "author": "Juvénal, Ier-IIe siècle"
    },
    {
      "start": 49.4,
      "end": 59.4,
      "latin": "Errare humanum est, perseverare diabolicum.",
      "translation": "L'erreur est humaine, persévérer est diabolique.",
      "author": "Sénèque (attribué)"
    },
    {
      "start": 59.4,
      "end": 66.4,
      "latin": "Memento mori.",
      "translation": "Souviens-toi que tu vas mourir.",
      "author": "Tradition Stoïcienne"
    },
    {
      "start": 66.4,
      "end": 74.4,
      "latin": "Omnes vulnerant, ultima necat.",
      "translation": "Toutes blessent, la dernière tue.",
      "author": "Inscription de cadran solaire"
    },
    {
      "start": 74.4,
      "end": 81.4,
      "latin": "Carpe diem.",
      "translation": "Cueille le jour.",
      "author": "Horace, 23 av. J.-C."
    },
    {
      "start": 81.4,
      "end": 89.4,
      "latin": "Audacibus fortuna juvat.",
      "translation": "La fortune sourit aux audacieux.",
      "author": "Virgile, Ier siècle av. J.-C."
    },
    {
      "start": 89.4,
      "end": 99.0,
      "latin": "Ad astra per ardua.",
      "translation": "Vers les étoiles à travers les difficultés.",
      "author": "Devise latine"
    }
  ]
